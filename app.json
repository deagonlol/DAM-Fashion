{
  "expo": {
    "name": "Lendr",
    "slug": "lendr",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "lendr",
    "userInterfaceStyle": "dark",
    "ios": {},
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#9BA215",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#9BA215",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Lendr uses your photos so you can list clothing.",
          "cameraPermission": "Lendr uses your camera so you can search for clothes with a photo.",
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Lendr uses your location only to show how far each campus pickup spot is."
        }
      ],
      [
        "expo-notifications",
        {
          "enableRemoteNotifications": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "tinyclipUrl": "https://lendr-tinyclip.onrender.com"
    }
  }
}
