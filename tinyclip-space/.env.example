# Copy to .env for local runs and backfill.py. On Render, enter these as the service's environment variables.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service role key: Supabase dashboard > Project Settings > API keys>
INDEX_SECRET=<long random string; also stored in Vault as tinyclip_index_secret>
# Optional
# TINYCLIP_MODEL=wkcn/TinyCLIP-ViT-39M-16-Text-19M-YFCC15M
# ALLOWED_ORIGINS=http://localhost:8081
